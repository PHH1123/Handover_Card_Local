# docker compose 로 백엔드를 띄울 때의 기본값. 저장소에 커밋되는 파일이므로
# 진짜 비밀 값은 여기 두지 말고 Handover_Card/.env 에 넣는다(그쪽이 이 파일을 덮어쓴다).
#
# 여기 없는 값은 application.yml 의 기본값이 그대로 쓰인다.

# 키가 없어도 파이프라인이 끝까지 도는 가짜 구현체. 실제 OpenAI 를 태우려면
# Handover_Card/.env 에 OPENAI_API_KEY 와 함께 openai 로 지정한다.
TRANSCRIPTION_PROVIDER=mock
SUMMARIZATION_PROVIDER=mock

# 로컬 전용 서명 키(32바이트 이상). 운영 값과 절대 같게 두지 않는다.
JWT_SECRET=docker-local-only-jwt-secret-please-change-in-any-real-environment

# 프론트를 5173(개발 서버) / 4173(정적 빌드)에서 띄우므로 포트를 열어 둔다.
# 다만 두 경우 모두 /api 는 프록시를 타기 때문에 실제로 CORS 가 필요하지는 않고,
# 브라우저에서 백엔드(8080)를 직접 부를 때를 위한 설정이다.
CORS_ALLOWED_ORIGINS=http://localhost:[*]

# 로컬은 HTTP 라 Secure 쿠키를 켜면 브라우저가 토큰을 보내지 않는다.
COOKIE_SECURE=false
