# docker compose 가 자동으로 읽는 파일. 기본값 그대로 써도 전부 뜨므로,
# 포트나 계정을 바꿔야 할 때만 `cp .env.example .env` 해서 고친다.
#
# 주의: 여기 값들은 DB/MinIO 컨테이너와 백엔드 양쪽에 동시에 들어간다(둘이 어긋나면 붙지 못한다).
# OpenAI 키·OAuth 클라이언트 같은 애플리케이션 비밀 값은 여기가 아니라
# Handover_Card/.env 에 넣는다. compose 가 그 파일을 백엔드 컨테이너에 그대로 넘긴다.

DB_USERNAME=handover
DB_PASSWORD=handover
DB_ROOT_PASSWORD=root

S3_ACCESS_KEY=handover
S3_SECRET_KEY=handover-secret
S3_BUCKET=handover-audio
S3_REGION=us-east-1
